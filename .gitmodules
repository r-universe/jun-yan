[submodule ".registry"]
	path = .registry
	url = https://github.com/r-universe-org/cran-to-git
	branch = HEAD
[submodule "KMsurv"]
	path = KMsurv
	url = https://github.com/jun-yan/kmsurv
[submodule "fgof"]
	path = fgof
	url = https://github.com/jun-yan/fgof
[submodule "tpr"]
	path = tpr
	url = https://github.com/cran/tpr
